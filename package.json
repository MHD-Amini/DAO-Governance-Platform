{
  "name": "dao-governance-platform",
  "version": "1.0.0",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "vite",
    "dev:sandbox": "wrangler pages dev dist --ip 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "wrangler pages dev dist",
    "deploy": "npm run build && wrangler pages deploy dist",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:verbose": "hardhat test --verbose",
    "test:coverage": "hardhat coverage",
    "test:gas": "REPORT_GAS=true hardhat test",
    "deploy:contracts": "hardhat run scripts/deploy.cjs --network hardhat",
    "deploy:localhost": "hardhat run scripts/deploy.cjs --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.cjs --network sepolia",
    "deploy:mainnet": "hardhat run scripts/deploy.cjs --network mainnet",
    "verify": "hardhat verify --network sepolia",
    "node": "hardhat node",
    "clean": "hardhat clean && rm -rf cache artifacts typechain-types",
    "size": "hardhat compile && hardhat run scripts/contract-size.cjs",
    "lint:sol": "solhint 'contracts/**/*.sol'",
    "format": "prettier --write 'contracts/**/*.sol' 'test/**/*.cjs' 'scripts/**/*.cjs'"
  },
  "keywords": [
    "dao",
    "governance",
    "blockchain",
    "ethereum",
    "solidity",
    "openzeppelin",
    "quadratic-voting",
    "defi",
    "web3",
    "smart-contracts"
  ],
  "author": "MHD-Amini",
  "license": "MIT",
  "description": "A production-ready DAO governance platform featuring quadratic voting, vote delegation, tiered membership, conviction tracking, and timelock-protected treasury management. Built with OpenZeppelin Governor framework and comprehensive security patterns.",
  "repository": {
    "type": "git",
    "url": "https://github.com/MHD-Amini/DAO-Governance-Platform"
  },
  "homepage": "https://github.com/MHD-Amini/DAO-Governance-Platform#readme",
  "bugs": {
    "url": "https://github.com/MHD-Amini/DAO-Governance-Platform/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@hono/node-server": "^1.19.7",
    "@hono/vite-cloudflare-pages": "^0.4.3",
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-ignition": "^0.15.16",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.17",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@nomicfoundation/ignition-core": "^0.15.15",
    "@openzeppelin/contracts": "^5.4.0",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "chai": "^4.5.0",
    "dotenv": "^16.6.1",
    "ethers": "^6.16.0",
    "hardhat": "^2.28.1",
    "hardhat-gas-reporter": "^2.3.0",
    "hono": "^4.11.3",
    "solidity-coverage": "^0.8.17",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "wrangler": "^4.54.0"
  }
}
