# ====================================
# DAO Governance Platform Environment
# ====================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# RPC Endpoints
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
MAINNET_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY

# Deployer Private Key (without 0x prefix)
# WARNING: Never share this key or commit it to git!
PRIVATE_KEY=your_private_key_here

# API Keys for Contract Verification
ETHERSCAN_API_KEY=your_etherscan_api_key

# Gas Reporter (optional)
REPORT_GAS=true
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key

# Frontend Configuration (optional)
VITE_CHAIN_ID=31337
VITE_CONTRACT_GOVERNOR=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0
VITE_CONTRACT_TOKEN=0x5FbDB2315678afecb367f032d93F642f64180aa3
VITE_CONTRACT_TREASURY=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
