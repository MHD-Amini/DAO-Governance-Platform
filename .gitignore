# ====================================
# DAO Governance Platform .gitignore
# ====================================

# Dependencies
node_modules/

# Build outputs
dist/
cache/
artifacts/
typechain-types/
out/

# Environment Variables (NEVER commit these!)
.env
.env.local
.env.production
.env.development
.env.*.local

# Hardhat
hardhat-cache/
cache/
artifacts/
deployments/localhost/
deployments/hardhat/

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# IDE
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# OS
.DS_Store
Thumbs.db
*.DS_Store
.AppleDouble
.LSOverride

# PM2
.pm2/
pids/
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Backup files
*.backup
*.bak

# Coverage
coverage/
coverage.json
.nyc_output/

# TypeChain
typechain/

# Gas Reports
gas-report.txt
gas-report.json

# Foundry (if used)
lib/
broadcast/

# Misc
*.tgz
*.tar.gz
*.zip

# Temporary files
tmp/
temp/
*.tmp

# Security - Never commit private keys or secrets
secrets/
.secrets
*.pem
*.key
